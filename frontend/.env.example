# Copy to frontend/.env.local. These Firebase values are safe to ship in a web app
# (security comes from firebase/firestore.rules). Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Leave blank in development (Vite forwards /api to localhost:8000).
# Set to the deployed backend URL for production, e.g. https://snowbelt-api.onrender.com
VITE_API_BASE=
