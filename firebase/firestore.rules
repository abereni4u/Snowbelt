rules_version = '2';
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each person's profile, emergency contacts and readiness checklist: only they can read or change it
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Neighbor help board
    match /helpRequests/{requestId} {
      allow read: if request.auth != null;

      // You can only post as yourself, and new requests start open
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open';

      // The person who asked can update their own request (e.g. mark resolved).
      // Anyone else signed in can only claim an open request, in their own name, with an ETA.
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid
        || (resource.data.status == 'open'
            && request.resource.data.status == 'claimed'
            && request.resource.data.claimedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedBy', 'claimedByName', 'etaMinutes', 'claimedAt']))
      );

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Volunteer hub: anyone signed in can see volunteers; you can only list or remove yourself
    match /volunteers/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // One rating per help request, written by the person who asked, about the person who claimed it
    match /ratings/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.raterUid == request.auth.uid
        && get(/databases/$(database)/documents/helpRequests/$(requestId)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/helpRequests/$(requestId)).data.claimedBy == request.resource.data.helperUid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
    }

    // Reports about volunteers: anyone signed in can file one; only the team reads them (console)
    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterUid == request.auth.uid;
    }
  }
}
