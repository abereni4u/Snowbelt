# Copy to backend/.env and fill in what you have. Anything left blank falls back to
# sample data or a dry run, so the app still starts. Never commit .env.

# Role 1: Gemini. Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Role 2: weather + routing
USE_LIVE_NWS=false
NWS_USER_AGENT=(snowbelt-hackathon, github.com/abereni4u/Snowbelt_UBHacking2026)
# Free key at https://openrouteservice.org
ORS_API_KEY=

# Role 4: accounts + help alerts
# Firebase console > Project settings > Service accounts > Generate new private key; put the path here
FIREBASE_CREDENTIALS=
# Email over SMTP. With Gmail: smtp.gmail.com, port 587, and an app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# SMS through Twilio (trial: verified numbers and Twilio templates only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

FRONTEND_ORIGINS=http://localhost:5173
